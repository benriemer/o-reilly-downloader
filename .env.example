# =============================================================================
# Shelf configuration
# Copy this file to .env and adjust the values before `docker compose up -d`.
# =============================================================================

# --- Web access -------------------------------------------------------------

# Binding to loopback keeps the UI reachable only from this machine.
# Use 0.0.0.0 only when a password is configured and/or a reverse proxy is in
# front of it.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# Recommended. If empty, Shelf runs in local-only mode with no login.
# Generate one with: openssl rand -base64 24
APP_PASSWORD=

# Signs browser sessions. Generate once with: openssl rand -hex 32
# If empty, a random secret is generated at startup and sessions are cleared
# whenever the web container restarts.
SESSION_SECRET=

# Set to 1 only when the UI is served over HTTPS.
COOKIE_SECURE=0

# Set to 1 when a reverse proxy supplies X-Forwarded-Proto / X-Forwarded-Host.
TRUST_PROXY=0

# Session lifetime in seconds (default: 7 days).
SESSION_TTL_SECONDS=604800

# --- Downloader -------------------------------------------------------------

# Optional shared secret between web and downloader. Even without it, the
# worker port is never published and is only reachable on the Compose network.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Number of simultaneous download jobs (1-4). The upstream CLI is heavy; 1 is
# recommended for books and courses. The worker caps this at 4.
MAX_CONCURRENT=1

# IANA timezone used for log timestamps.
TZ=UTC

# --- Host permissions -------------------------------------------------------

# UID/GID that owns ./config on the host. The web container writes cookie
# files there. Use `id -u` and `id -g` to find your values.
LOCAL_UID=1000
LOCAL_GID=1000

# --- Images (optional) ------------------------------------------------------

# DOWNLOADER_IMAGE=oreilly-downloader:latest
# WEB_IMAGE=shelf-web:latest
