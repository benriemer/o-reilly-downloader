# Force TLS 1.2 to work around Akamai edge closing TLS 1.3 handshakes
# to learning.oreilly.com (unexpected EOF during ClientHello).
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.2
MaxProtocol = TLSv1.2
